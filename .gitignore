# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.ipynb_checkpoints/

# Environments
.venv/
venv/
env/
ENV/
.env
.conda/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# Data — raw and processed datasets are fetched by scripts/download_data.py
# and reproduced from the documented source, so they are not committed.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Results — regenerated by scripts/run_experiments.py.
# Figures/tables/metrics are committed because the paper references them;
# raw predictions and model weights are not.
results/models/*
results/predictions/*
!results/models/.gitkeep
!results/predictions/.gitkeep
*.pt
*.pth
*.onnx
*.joblib
*.pkl

# Secrets
.env
.env.*
secrets.yml
*.pem
*_rsa
*_ed25519
credentials.json
service-account*.json

# Editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/

# LaTeX auxiliary (paper is authored in Markdown; no build artefacts committed)
*.aux
*.bbl
*.blg
*.out
*.toc
